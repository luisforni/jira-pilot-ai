# Application
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
SECRET_KEY=change-me-in-production

# Jira
JIRA_URL=https://yourcompany.atlassian.net
JIRA_EMAIL=your@email.com
JIRA_API_TOKEN=your-jira-api-token
JIRA_PROJECT_KEY=PROJ

# AI Providers
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/jira_pilot

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Qdrant (vector store)
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=jira_pilot_knowledge

# Git
GIT_DEFAULT_BRANCH=develop
GIT_AUTHOR_NAME=JiraPilot AI
GIT_AUTHOR_EMAIL=ai@jira-pilot.dev

# n8n
N8N_WEBHOOK_SECRET=change-me-in-production

# Sandbox
SANDBOX_PYTHON_IMAGE=jira-pilot-sandbox-python:latest
SANDBOX_NODE_IMAGE=jira-pilot-sandbox-node:latest
SANDBOX_TIMEOUT_SECONDS=120
SANDBOX_MEM_LIMIT=512m
# Build sandbox images first: bash sandbox/images/build.sh
